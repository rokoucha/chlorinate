{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended", 
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigests",
    "customManagers:githubActionsVersions"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^flake\\.nix$/"],
      "matchStrings": [
        "# renovate: datasource=github-release-attachments depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+mapeToolVersion = \"(?<currentValue>[^\"]+)\";\\s+mapeToolHash = \"(?<currentDigest>[a-f0-9]+)\";"
      ],
      "datasourceTemplate": "github-release-attachments",
      "autoReplaceStringTemplate": "# renovate: datasource=github-release-attachments depName={{{depName}}} versioning={{{versioning}}}\n      mapeToolVersion = \"{{{newValue}}}\";\n      mapeToolHash = \"{{{newDigest}}}\";"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^flake\\.nix$/"],
      "matchStrings": [
        "nixpkgs\\.url = \"github:NixOS/nixpkgs/nixos-(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "NixOS/nixpkgs",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)$",
      "autoReplaceStringTemplate": "nixpkgs.url = \"github:NixOS/nixpkgs/nixos-{{{newValue}}}\""
    }
  ],
  "nix": {
    "enabled": false
  }
}
